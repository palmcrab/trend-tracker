  "glossary": [
    {
      "term": "Токенизация",
      "topic": "token",
      "def": "Перенос права на актив в цифровую запись в реестре, которой можно управлять программно.",
      "mentions": 43
    },
    {
      "term": "Agentic commerce (агентная коммерция)",
      "topic": "agcom",
      "def": "Модель, где ИИ-агенты сами ищут, сравнивают, торгуются и покупают за человека.",
      "mentions": 40
    },
    {
      "term": "KYA (Know Your Agent)",
      "topic": "kya",
      "def": "Верификация ИИ-агента перед доступом и оплатой: идентичность, мандат, лимиты, аудит.",
      "mentions": 37
    },
    {
      "term": "RWA (real-world assets)",
      "topic": "token",
      "def": "Токенизированные реальные активы — облигации, фонды, недвижимость, private credit.",
      "mentions": 36
    },
    {
      "term": "ЦФА (цифровые финансовые активы)",
      "topic": "token",
      "def": "Правовая форма токена в РФ (259-ФЗ): денежные и эмиссионные права.",
      "mentions": 35
    },
    {
      "term": "Principal-agent theory",
      "topic": "agmgmt",
      "def": "Классическая агентская проблема управления; переносится на ИИ-агентов.",
      "mentions": 31
    },
    {
      "term": "KYC (Know Your Customer)",
      "topic": "kya",
      "def": "Установление и проверка личности клиента; основа доверия, KYA — надстройка.",
      "mentions": 28
    },
    {
      "term": "x402",
      "topic": "agcom",
      "def": "Открытый протокол Coinbase: агент мгновенно платит стейблкоином за один HTTP-запрос.",
      "mentions": 27
    },
    {
      "term": "Agent governance",
      "topic": "agmgmt",
      "def": "Правила, мандаты и контроль автономных агентов, подотчётность.",
      "mentions": 27
    },
    {
      "term": "AP2 (Agent Payments Protocol)",
      "topic": "agcom",
      "def": "Протокол Google для авторизации платежей агентов; использует x402.",
      "mentions": 25
    },
    {
      "term": "Stablecoin (стейблкоин)",
      "topic": "agcom",
      "def": "Криптомонета, привязанная к валюте (USDC); расчётный актив агентных платежей.",
      "mentions": 20
    },
    {
      "term": "УЦП (утилитарные цифровые права)",
      "topic": "token",
      "def": "«Полезное» цифровое право (товар/услуга/доступ) через инвестплатформы.",
      "mentions": 19
    },
    {
      "term": "Scoped mandate",
      "topic": "kya",
      "def": "Ограниченный мандат агента: что он вправе оплачивать, лимиты, срок.",
      "mentions": 16
    },
    {
      "term": "MCP (Model Context Protocol)",
      "topic": "agmgmt",
      "def": "Стандарт подключения инструментов и контекста к ИИ-моделям.",
      "mentions": 14
    },
    {
      "term": "A2A (Agent-to-Agent)",
      "topic": "agmgmt",
      "def": "Протокол взаимодействия агентов между собой.",
      "mentions": 12
    },
    {
      "term": "Audit-log",
      "topic": "kya",
      "def": "Неизменяемый журнал действий агента для подотчётности.",
      "mentions": 11
    },
    {
      "term": "BUIDL",
      "topic": "token",
      "def": "Токенизированный фонд денежного рынка BlackRock.",
      "mentions": 9
    },
    {
      "term": "ACP (Agentic Commerce Protocol)",
      "topic": "agcom",
      "def": "Формирующийся протокол агентной коммерции.",
      "mentions": 6
    },
    {
      "term": "Breakage",
      "topic": "token",
      "def": "Несписанные баллы/токены лояльности как источник экономики.",
      "mentions": 4
    },
    {
      "term": "Loyalty OS",
      "topic": "agcom",
      "def": "Открытая нейтральная платформа лояльности поверх платежей.",
      "mentions": 2
    }
